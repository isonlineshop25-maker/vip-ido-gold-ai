#!/usr/bin/env bash
# Haalt de nieuwste versie van VIP IDO GOLD AI van GitHub en installeert hem.
# Gebruik op de server:  ido-update
set -Eeuo pipefail
SRC=/opt/ido-gold-ai-src
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
echo "==> Nieuwste versie ophalen van GitHub"
git -C "$SRC" fetch --depth 1 origin main
OLD="$(git -C "$SRC" rev-parse --short HEAD)"
git -C "$SRC" reset --hard origin/main
NEW="$(git -C "$SRC" rev-parse --short HEAD)"
if [[ "$OLD" == "$NEW" && "${1:-}" != "--force" ]]; then
  echo "Je hebt al de nieuwste versie ($NEW). Niets te doen."
  exit 0
fi
echo "==> Versie $OLD -> $NEW installeren"
bash "$SRC/install-ubuntu.sh"
echo "Update klaar: versie $NEW."
