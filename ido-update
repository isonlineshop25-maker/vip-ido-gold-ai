#!/usr/bin/env bash
# Haalt de nieuwste versie van je bots van GitHub en installeert ze.
# Gebruik op de server:  ido-update          (alleen als er iets nieuws is)
#                        ido-update --force  (altijd opnieuw installeren)
set -Eeuo pipefail
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
updated=0
for SRC in /opt/ido-gold-ai-src /opt/ido-aandelen-src; do
  [[ -d "$SRC/.git" ]] || continue
  name="$(basename "$SRC" -src)"
  echo "==> $name: nieuwste versie ophalen"
  git -C "$SRC" fetch --depth 1 origin main
  OLD="$(git -C "$SRC" rev-parse --short HEAD)"
  git -C "$SRC" reset --hard origin/main
  NEW="$(git -C "$SRC" rev-parse --short HEAD)"
  if [[ "$OLD" == "$NEW" && "${1:-}" != "--force" ]]; then
    echo "    al up-to-date ($NEW)"
    continue
  fi
  if [[ -f "$SRC/install-ubuntu.sh" ]]; then bash "$SRC/install-ubuntu.sh"; fi
  for inst in "$SRC"/server/install-*.sh; do [[ -f "$inst" ]] && bash "$inst"; done
  echo "    $name bijgewerkt: $OLD -> $NEW"
  updated=1
done
[[ $updated -eq 1 ]] && echo "Update klaar." || echo "Niets te doen: alles is al de nieuwste versie."
